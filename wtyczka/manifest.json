{
  "manifest_version": 3,
  "name": "ClearTerms AI Extension",
  "version": "1.0",
  "description": "Analyses company privacy policy and provides a clear summary and rating with a direct connection to the ClearTerms platform.",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "https://r.jina.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_popup": "popup.html",
    "default_title": "Rate the privacy policy"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
